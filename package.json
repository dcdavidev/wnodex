{
  "name": "@wnodex/workspace",
  "private": true,
  "description": "Web Node Express: an extensible and robust express.js server class designed for effortless customization and rapid deployment.",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm run check-types && pnpm run lint && pnpm run fmt && pnpm run spellcheck",
    "check:ci": "pnpm run check-types && pnpm run lint:check && pnpm run fmt:check && pnpm run spellcheck",
    "check-types": "turbo run check-types",
    "commit": "cz",
    "commit:lint": "commitlint --from=HEAD~1",
    "fmt": "prettier --ignore-unknown --write .",
    "fmt:check": "prettier --ignore-unknown --check .",
    "format": "prettier --ignore-unknown --write .",
    "lint": "eslint --no-warn-ignored --fix .",
    "lint:check": "eslint --no-warn-ignored .",
    "prepare": "lefthook install || true",
    "release": "dropdx",
    "release:dry": "dropdx --dry-run",
    "release:major": "dropdx --major",
    "release:minor": "dropdx --minor",
    "release:patch": "dropdx --patch",
    "spellcheck": "cspell --no-progress --no-summary ."
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@cspell/cspell-types": "^10.4.0",
    "@dcdavidev/dropdx": "^0.2.0",
    "@spellbookx/recipes": "^1.0.1",
    "commitizen": "^4.3.2",
    "commitlint-config-spellbookx": "^1.0.1",
    "cspell": "^10.4.0",
    "cspell-config-spellbookx": "^1.0.1",
    "cz-git": "^1.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-spellbookx": "^1.0.1",
    "lefthook": "^2.2.2",
    "prettier": "3.9.6",
    "prettier-config-spellbookx": "^1.0.1",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  }
}
